# FastAPI backend: the web-app API lives under /api/app (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api/app

# Demo mode: true = in-browser mock backend (no FastAPI/Supabase needed), false = real backend
VITE_DEMO_MODE=false

# Supabase project (public values only — NEVER put the service-role key here).
# Needed for Realtime; without them the app falls back to polling.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Optional: default map centre when the browser location is unavailable
VITE_DEFAULT_LAT=12.9716
VITE_DEFAULT_LNG=77.5946

# Optional: currency used for display
VITE_CURRENCY=INR
